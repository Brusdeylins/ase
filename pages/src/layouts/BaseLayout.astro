/*  base layout for every page of the ASE site: dark-by-default <html>, SEO
    head, a floating header with a scroll-progress bar, a footer, and a
    back-to-top button with a scroll-progress ring. The scroll-reveal
    IntersectionObserver and the scroll-progress logic are vendored and adapted
    from Astro Rocket (MIT).  */

import                    "../styles/theme.css"
import { site }      from "../data/site.ts"
import ThemeInit     from "../components/Feature-Theme-Init.astro"
import PageHeader    from "../components/Section-Header.astro"
import PageFooter    from "../components/Section-Footer.astro"
import ModalVideo    from "../components/Modal-Video.astro"
import ModalImage    from "../components/Modal-Image.astro"
import ModalHelp     from "../components/Modal-Help.astro"
import ModalQR       from "../components/Modal-QR.astro"
import StickyCTA     from "../components/Widget-Sticky-CTA.astro"
import ProgressRing  from "../components/Widget-Progress-Ring.astro"
import Progress      from "../components/Feature-Progress.astro"
import ClipboardCopy from "../components/Feature-Clipboard-Copy.astro"
import ScrollReveal  from "../components/Feature-Scroll-Reveal.astro"
import ExternalLinks from "../components/Feature-External-Links.astro"

interface Props {
    title?:       string   /*  page title, prefixed onto the site title      */
    description?: string   /*  page meta description                         */
    pad?:         boolean  /*  pad <main> clear of the fixed header/CTA bar  */
}

const { title, description, pad } = Astro.props

/*  the hero page brings its own top and bottom spacing, while every content
    page has to be pushed clear of the fixed header (by the very offset the
    former section anchors used) and of the sticky install bar.  */
const mainClass = pad === true ? "pt-20 pb-24" : undefined

const pageTitle = title !== undefined ? `${title} — ${site.title}` : site.title
const pageDesc  = description ?? site.description
const canonical = new URL(Astro.url.pathname, Astro.site).href
---
<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/assets/ase-logo.svg" />
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content={site.themeColor} />

        <title>{pageTitle}</title>
        <meta name="description" content={pageDesc} />
        <meta name="author" content={site.author} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDesc} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />

        <ThemeInit/>
    </head>
    <body>
        <PageHeader/>

        {/*  "relative isolate" gives the per-page <GlowTop/> wash its
             positioning context and keeps it stacked below the page content.  */}
        <main class:list={[ "relative isolate", mainClass ]}>
            <slot/>
        </main>

        <PageFooter/>

        <ModalVideo/>
        <ModalImage/>
        <ModalHelp/>
        <ModalQR/>

        <StickyCTA/>

        <ProgressRing/>
        <Progress/>

        <ScrollReveal/>
        <ExternalLinks/>

        <ClipboardCopy/>
    </body>
</html>
