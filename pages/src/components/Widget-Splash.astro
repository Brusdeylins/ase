/*  splash icon: a tilted, brown starburst "sticker" announcing the
    highlights of a release, with a gentle pulse to catch the eye,
    optionally linking to a page with the details via "href".  */

interface Props {
    class?: string
    href?:  string
}
const { class: className, href } = Astro.props
const Tag = href ? "a" : "div"

/*  starburst geometry (SVG user units): alternating outer/inner radii
    around the centre form the jagged "splash" silhouette.  */
const S      = 220    /*  overall size (square)  */
const C      = S / 2  /*  centre                 */
const spikes = 24     /*  number of spikes       */
const rOuter = 106    /*  spike tip radius       */
const rInner = 94     /*  spike base radius      */
const path = Array.from({ length: spikes * 2 }, (_, i) => {
    const r = i % 2 === 0 ? rOuter : rInner
    const a = (Math.PI * i) / spikes - Math.PI / 2
    return `${i === 0 ? "M" : "L"} ${(C + r * Math.cos(a)).toFixed(2)} ${(C + r * Math.sin(a)).toFixed(2)}`
}).join(" ") + " Z"

/*  feature lines of the announcement, below the headline  */
const lines = [
    "Compact Grilling,",
    "WUI & TUI Task Boards,",
    "Autonomous Agents,",
    "and many more"
]
---
<Tag href={href} class={`splash block select-none ${href ? "" : "pointer-events-none"} ${className ?? ""}`}>
    <svg
        class="splash-icon block h-auto w-full"
        viewBox={`0 0 ${S} ${S}`}
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="ASE 2.0: Compact Grilling, WUI & TUI Task Boards, Autonomous Agents, and many more"
    >
        <defs>
            {/* radial brown gradient for the starburst body */}
            <radialGradient id="splash-fill" cx="40%" cy="35%" r="75%">
                <stop offset="0%"   stop-color="#b07a46" />
                <stop offset="60%"  stop-color="#7a4b25" />
                <stop offset="100%" stop-color="#4e2f16" />
            </radialGradient>

            {/* soft drop shadow so the splash reads as a sticker on the hero */}
            <filter id="splash-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.45" />
            </filter>
        </defs>

        {/* starburst body and inner decoration ring */}
        <path d={path} fill="url(#splash-fill)" stroke="#d9a76e" stroke-width="2" stroke-linejoin="round" filter="url(#splash-shadow)" />
        <circle cx={C} cy={C} r="88" fill="none" stroke="#e8c59a" stroke-width="1" stroke-dasharray="3 4" opacity="0.6" />

        {/* headline and feature lines */}
        <text x={C} y="82" text-anchor="middle" fill="#ffe2b8" font-size="30" font-weight="bold" letter-spacing="0.5">
            ASE 2.0
        </text>
        <line x1={C - 44} y1="93" x2={C + 44} y2="93" stroke="#e8c59a" stroke-width="1.5" opacity="0.8" />
        <text text-anchor="middle" fill="#fff4e4" font-size="15" font-weight="600">
            {lines.map((line, i) => (
                <tspan x={C} y={114 + i * 18}>{line}</tspan>
            ))}
        </text>
    </svg>
</Tag>

<style>
    /*  tilted sticker with a gentle "attention" pulse (the typography reset
        avoids inheriting the tight letter-spacing of a surrounding heading)  */
    .splash {
        transform: rotate(-12deg);
        letter-spacing: normal;
        line-height: normal;
        font-family: var(--font-sans);
        transition: transform 200ms ease-out;
    }
    a.splash:hover {
        transform: rotate(-6deg) scale(1.08);
    }
    .splash-icon {
        animation: splash-pulse 3s ease-in-out infinite;
    }
    @keyframes splash-pulse {
        0%, 100% { transform: scale(1.00); }
        50%      { transform: scale(1.06); }
    }
    @media (prefers-reduced-motion: reduce) {
        .splash-icon { animation: none; }
    }
</style>
