/*  "Productivity" section: the three-way comparison table, contrasting a set
    of recurring work-steps done old-school by hand, done with the bare Claude
    Code CLI, and done with the very same tool boosted by the ASE plugin.  */

import Annotation     from "./Widget-Annotation.astro"
import { comparison } from "../data/comparison.ts"

/*  the three comparison-table column icons, staging the same progression the
    columns themselves describe: hand tool, AI assistance, boosted AI  */

import Hammer         from "@lucide/astro/icons/hammer"
import Sparkles       from "@lucide/astro/icons/sparkles"
import Rocket         from "@lucide/astro/icons/rocket"

/*  the route this section is rendered on: the man-page links below stay on it,
    so closing the man page returns the reader to this very page  */
const here = Astro.url.pathname

/*  render lightweight inline markup in the comparison cells: turn "**...**"
    into <b>...</b>, "*...*" into <i>...</i>, and "`...`" into <code>...</code>.
    The "**" pass runs first so the single-asterisk pass never consumes a bold
    marker. A backticked ASE slash command additionally becomes a link to the
    man page of its skill, opened by the help modal of BaseLayout; that pass
    runs before the plain backtick pass, which then picks up all the remaining
    code spans (e.g. the agent's own `WebSearch` tool).  */
const inline = (text: string) => text
    .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
    .replace(/\*(.+?)\*/g,     "<i>$1</i>")
    .replace(/`\/(ase-[a-z]+-[a-z]+)`/g,
             `<a href="${here}#help/$1" class="cmd-help"><code>/$1</code></a>`)
    .replace(/`(.+?)`/g,       "<code>$1</code>")
---
<section id="productivity" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-2/4">
                Rethink your habits<br/>
                and boost yourself!
            </Annotation>
            See the <span class="text-accent">Productivity Difference</span>
        </h2>
        <p class="mt-4 text-foreground-secondary ase-justify">
            Claude Code CLI is already fantastic, but it can become
            even better in the context of Software Engineering. Some
            sample, recurring work-steps, done three ways: old-school by
            hand, with the bare Claude Code CLI tool, and with the same
            tool boosted by the <b>ASE</b> plugin.
        </p>
    </header>

    <div class="mt-6 overflow-hidden rounded-xl border border-border-strong p-3 shadow-xl sm:p-4" data-reveal>
        <table class="ase-compat-table w-full text-left text-xs sm:text-sm">
            <thead>
                {/*  the icon sits on its own flex line, which makes the
                     following <i> subtitle start a new line by itself and
                     so replaces the former <br/>  */}
                <tr class="border-b border-border-strong text-accent">
                    <th class="pb-2 pr-1 font-semibold sm:pr-2"></th>
                    <th class="pb-2 px-1 font-semibold sm:px-2">
                        <span class="flex items-center gap-1.5"><Hammer class="h-4 w-4 shrink-0" stroke-width={0.75}/>Manually:</span>
                        <i>Old-School</i>
                    </th>
                    <th class="pb-2 px-1 font-semibold sm:px-2">
                        <span class="flex items-center gap-1.5"><Sparkles class="h-4 w-4 shrink-0" stroke-width={0.75}/>Claude Code CLI:</span>
                        <i>AI Native</i>
                    </th>
                    <th class="pb-2 pl-1 font-semibold sm:pl-2">
                        <span class="flex items-center gap-1.5"><Rocket class="h-4 w-4 shrink-0" stroke-width={0.75}/>Claude Code CLI + ASE:</span>
                        <i>AI Advanced</i>
                    </th>
                </tr>
            </thead>
            <tbody>
                {comparison.map((row) => (
                    <tr class="border-b border-border-strong last:border-0">
                        <td class="py-1 pr-1 align-top font-bold text-accent     sm:pr-2" set:html={inline(row.topic)} />
                        <td class="py-1 px-1 align-top text-foreground-muted     sm:px-2" data-label="Manually:"            set:html={inline(row.manually)} />
                        <td class="py-1 px-1 align-top text-foreground-secondary sm:px-2" data-label="Claude Code CLI:"     set:html={inline(row.native)} />
                        <td class="py-1 pl-1 align-top text-foreground           sm:pl-2" data-label="Claude Code CLI + ASE:" set:html={inline(row.ase)} />
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>

<style is:global>
    /*  the man-page link wrapped around an ASE command chip. It has to be
        global: the cells are injected via `set:html`, which Astro's scoped
        styles do not reach. The chip keeps the colour the global `code` rule
        gives it, so the link only adds the grab cursor and marks the hover
        with an underline, mirroring the command rows of the Terminal.  */
    .cmd-help {
        color: inherit;
        cursor: grab;
        text-decoration: none;
    }
    .cmd-help:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
</style>

<style>
    /*  on small screens, collapse the multi-column comparison table into a
        single-column, stacked-card layout: the header row is hidden, each
        row becomes a card, the topic cell its heading, and every data cell
        a labelled line prefixed by its column name via the "data-label"
        attribute. above the "sm" breakpoint the native table layout applies.  */
    @media (max-width: 639px) {
        .ase-compat-table,
        .ase-compat-table tbody,
        .ase-compat-table tr,
        .ase-compat-table td {
            display: block;
            width: 100%;
        }
        .ase-compat-table thead {
            display: none;
        }
        .ase-compat-table tr {
            padding: 0.75rem 0;
        }
        .ase-compat-table td {
            padding-left: 0;
            padding-right: 0;
        }
        .ase-compat-table td:first-child {
            margin-bottom: 0.375rem;
            font-size: 0.875rem;
        }
        .ase-compat-table td[data-label]::before {
            content: attr(data-label);
            display: block;
            font-weight: 600;
            font-style: italic;
            color: var(--color-accent);
        }
        .ase-compat-table td[data-label] {
            margin-top: 0.375rem;
        }
    }
</style>
