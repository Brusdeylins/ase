/*  floating site header: the ASE logo, the site-wide page nav (highlighting
    the current page via `nav-spy`/`is-active`), the GitHub link, the (hidden)
    theme switcher, and the scroll-progress bar along its bottom edge.  */

import { navHome, navItems, navAuthor, navProject } from "../data/nav.ts"
import NavEntry                                    from "./Widget-Nav-Entry.astro"
import LogoASE                                     from "./Widget-Logo-ASE.astro"
import LogoGitHub                                  from "./Widget-Logo-GitHub.astro"
import ThemeSwitcher                               from "./Widget-Theme-Switcher.astro"
import ProgressBar                                 from "./Widget-Progress-Bar.astro"

/*  the route path of the currently rendered page, normalized to the trailing
    slash the nav entries carry (the dev server serves them without one)  */
const current = Astro.url.pathname.replace(/\/*$/, "/")
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-border/60">
    {/*  header background as a separate, absolutely-positioned layer rather than
         a `backdrop-blur` on the <header> itself: a `backdrop-filter` on the
         header would establish a backdrop root that nullifies the mobile nav
         panel's own blur (a descendant cannot re-blur an already-blurred
         ancestor). Keeping it a sibling layer lets the panel blur the page
         directly.  */}
    <div
        class="nav-bar-bg pointer-events-none absolute inset-0 -z-10"
        aria-hidden="true"
    ></div>
    {/*  the container carries the very width and padding of the page content,
         so the leading home logo and the trailing project entry sit exactly on
         the left and right border of the pages below.  */}
    <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4">
        {/*  below the `lg` breakpoint the nav collapses into the `#nav-menu`
             panel, which takes the home entry with it, so the logo is shown
             here on its own instead.  */}
        <a href="/" aria-label="Home" class="flex items-center gap-3 font-display text-lg font-bold lg:hidden">
            <LogoASE class="h-[1.0rem] w-auto" idPrefix="ase-navlogo" />
        </a>

        {/*  hamburger toggle: visible only below the `lg` breakpoint, where the
             nav collapses into the `#nav-menu` panel below.  */}
        <button
            id="nav-toggle"
            type="button"
            aria-label="Toggle navigation menu"
            aria-controls="nav-menu"
            aria-expanded="false"
            class="flex cursor-grab items-center rounded-md border border-border px-2 py-1 text-foreground-secondary transition-colors hover:border-border-strong hover:text-foreground lg:hidden"
        >
            <span class="nav-toggle-open w-5 justify-center text-xl leading-none text-accent not-[.hidden]:inline-flex">☰</span><span class="nav-toggle-close hidden w-5 justify-center text-xl leading-none text-accent not-[.hidden]:inline-flex">✕</span>
        </button>

        {/*  the collapsible navigation panel: a horizontal in-line nav from the
             `lg` breakpoint upwards, and (below it) an auto-width drop-down panel
             anchored to the top-right of the header, toggled by `#nav-toggle`
             via the `data-open` attribute.  */}
        <div
            id="nav-menu"
            class="link-plain nav-menu-panel absolute right-6 top-full hidden w-auto flex-col items-end gap-y-1.5 rounded-md rounded-t-none border border-border/60 p-4 shadow-lg data-[open]:flex lg:static lg:top-auto lg:flex lg:w-auto lg:flex-1 lg:flex-row lg:items-center lg:justify-between lg:gap-x-5 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
        >
            <nav class="flex min-w-0 flex-col flex-wrap items-end gap-x-2 xl:gap-x-4 gap-y-1 text-base text-foreground-secondary lg:flex-row lg:items-center">
                {/*  the ASE logo is the label of the home entry  */}
                <NavEntry entry={navHome} current={current} labelHidden>
                    <LogoASE class="h-[1.0rem] w-auto" idPrefix="ase-navlogo-home" />
                </NavEntry>
                {navItems.map((entry) =>
                    <NavEntry entry={entry} current={current}/>
                )}
            </nav>
            <nav class="flex flex-col flex-wrap items-end gap-x-2 xl:gap-x-4 gap-y-1 text-base text-foreground-secondary lg:flex-row lg:items-center">
                {/*  the author signet is part of the very entry it labels, so
                     the box of the open pull-down surrounds both  */}
                <NavEntry entry={navAuthor} current={current} align="right">
                    <img src="/assets/rse-signet.svg" alt="Dr. Ralf S. Engelschall" class="h-[1.2rem] w-auto"/>
                </NavEntry>
                {/*  the GitHub logo is part of the very entry it labels, too  */}
                <NavEntry entry={navProject} current={current} align="right">
                    <LogoGitHub class="h-4 w-4"/>
                </NavEntry>
                <ThemeSwitcher class="hidden"/>
            </nav>
        </div>
    </div>
    <ProgressBar />
</header>

{/*  hamburger toggle: open/close the collapsed nav panel below the `lg`
     breakpoint, and auto-close it whenever a nav link is clicked.  */}
<script is:inline>
    (function () {
        const btn  = document.getElementById("nav-toggle")
        const menu = document.getElementById("nav-menu")
        if (!btn || !menu) return
        const setOpen = function (open) {
            if (open)
                menu.setAttribute("data-open", "")
            else
                menu.removeAttribute("data-open")
            btn.setAttribute("aria-expanded", open ? "true" : "false")
            btn.querySelector(".nav-toggle-open").classList.toggle("hidden", open)
            btn.querySelector(".nav-toggle-close").classList.toggle("hidden", !open)
        }
        /*  open/close the pull-down panel of a single navigation group (above
            the `lg` breakpoint, hovering a group opens it via CSS as well).  */
        const groups = Array.prototype.slice.call(menu.querySelectorAll(".nav-group"))
        const setGroupOpen = function (group, open) {
            const toggle = group.querySelector(".nav-group-toggle")
            const panel  = group.querySelector(".nav-group-menu")
            if (open)
                panel.setAttribute("data-open", "")
            else
                panel.removeAttribute("data-open")
            if (toggle.tagName === "BUTTON")
                toggle.setAttribute("aria-expanded", open ? "true" : "false")
        }
        const closeGroups = function (except) {
            groups.forEach(function (group) {
                if (group !== except)
                    setGroupOpen(group, false)
            })
        }

        /*  a group whose label is a page of its own carries a link instead of
            a toggle button, so its panel is opened by hovering alone.  */
        const hoverable = window.matchMedia("(width >= 64rem)")
        groups.forEach(function (group) {
            const toggle = group.querySelector(".nav-group-toggle")
            if (toggle.tagName !== "BUTTON")
                return
            toggle.addEventListener("click", function (ev) {
                /*  above the `lg` breakpoint the hover (or focus) already
                    opened the panel, so a click has nothing to toggle: a
                    `data-open` set here would outlive the hover and keep the
                    panel open next to the one hovered afterwards. A pointer
                    click merely drops the focus it left on the label, which
                    would hold the panel open via `:focus-within` just the
                    same, while a keyboard activation (`detail` of 0) keeps
                    its focus.  */
                if (hoverable.matches) {
                    if (ev.detail > 0)
                        toggle.blur()
                    return
                }
                const open = !group.querySelector(".nav-group-menu").hasAttribute("data-open")
                closeGroups(group)
                setGroupOpen(group, open)
            })
        })

        /*  the section entries ("/foo/bar/#quux") whose target section lives on
            the very page shown, paired with that target element. The targets
            are parsed after this header, so they are picked up once the whole
            document stands.  */
        const sections = []
        const collectSections = function () {
            const here = location.pathname.replace(/\/*$/, "/")
            menu.querySelectorAll("[data-nav-path]").forEach(function (link) {
                const path = link.getAttribute("data-nav-path")
                const at   = path.indexOf("#")

                /*  the page has to match as well: the same fragment name may
                    well address a section on another page, too  */
                if (at < 0 || path.slice(0, at) !== here)
                    return
                const el = document.getElementById(path.slice(at + 1))
                if (el !== null)
                    sections.push({ link: link, el: el })
            })
            syncActive()
        }

        /*  mark the navigation entries selected by the current viewport: an
            entry addressing a page is selected while that page is shown, an
            entry addressing a section while that section is the one scrolled
            to, and a group label while it or any of its members is selected.
            None of this is known at build-time, so the rendered state is
            refined here and kept in sync while the page is scrolled.  */
        const syncActive = function () {
            const here = location.pathname.replace(/\/*$/, "/")

            /*  the section scrolled to: the last one whose top edge has
                entered the upper fifth of the viewport. The mark sits well
                below the fixed header, so a section jumped to by its fragment
                -- which lands at the `scroll-padding-top` of 5rem, plus its
                own top margin -- counts as entered right away.  */
            let entered = sections.length > 0 ? sections[0].link : null
            sections.forEach(function (section) {
                if (section.el.getBoundingClientRect().top <= 200)
                    entered = section.link
            })

            menu.querySelectorAll("[data-nav-path]").forEach(function (link) {
                const path   = link.getAttribute("data-nav-path")
                const at     = path.indexOf("#")
                const active = at < 0 ? here === path : link === entered
                link.classList.toggle("is-active", active)
                if (active)
                    link.setAttribute("aria-current", at < 0 ? "page" : "true")
                else
                    link.removeAttribute("aria-current")
            })
            groups.forEach(function (group) {
                const toggle = group.querySelector(".nav-group-toggle")
                const own    = toggle.hasAttribute("data-nav-path") && toggle.classList.contains("is-active")
                toggle.classList.toggle("is-active",
                    own || group.querySelector(".nav-group-menu .is-active") !== null)
            })
        }
        syncActive()
        if (document.readyState === "loading")
            document.addEventListener("DOMContentLoaded", collectSections)
        else
            collectSections()
        window.addEventListener("hashchange", syncActive)

        /*  follow the scrolling, coalesced into one pass per rendered frame  */
        let pending = false
        window.addEventListener("scroll", function () {
            if (pending)
                return
            pending = true
            window.requestAnimationFrame(function () {
                pending = false
                syncActive()
            })
        }, { passive: true })

        btn.addEventListener("click", function () {
            closeGroups()
            setOpen(!menu.hasAttribute("data-open"))
        })
        /*  clicking an entry closes the navigation again. A click leaves the
            pointer resting on the group, where the hover above the `lg`
            breakpoint would immediately re-open the pull-down panel, so the
            group is additionally held shut until the pointer has left it.  */
        menu.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
                const group = link.closest(".nav-group")
                if (group !== null)
                    group.setAttribute("data-closed", "")
                closeGroups()
                setOpen(false)
            })
        })
        groups.forEach(function (group) {
            group.addEventListener("pointerleave", function () {
                group.removeAttribute("data-closed")
            })
        })

        /*  close the open panels when clicking anywhere outside of them or the
            toggle button (the toggles handle their own clicks above).  */
        document.addEventListener("click", function (ev) {
            groups.forEach(function (group) {
                if (!group.contains(ev.target))
                    setGroupOpen(group, false)
            })
            if (!menu.hasAttribute("data-open"))
                return
            if (menu.contains(ev.target) || btn.contains(ev.target))
                return
            setOpen(false)
        })
    })()
</script>

<style is:global>
    /*  the nav link of the currently rendered page (and any hovered link)
        adopts the foreground colour (white); weight is left unchanged.  */
    .nav-spy.is-active,
    .nav-spy:hover { color: var(--foreground); }

    /*  non-spy nav link (e.g. "Project"): on hover it adopts the foreground
        colour (white), mirroring the .nav-spy links. The `!important` beats the
        unlayered global `a {}` rule.  */
    .nav-link:hover { color: var(--foreground) !important; }

    /*  the pull-down panel of a navigation group: opened by clicking its
        label (which sets the `data-open` attribute) and, from the `lg`
        breakpoint upwards, also by hovering or focusing the group itself.  */
    .nav-group-menu[data-open] { display: flex; }

    /*  a group whose label is a page of its own carries a link instead of a
        toggle button, so below the `lg` breakpoint -- where hovering is no
        option -- its members are listed permanently in the collapsed panel  */
    @media (width < 64rem) {
        .nav-group-menu.nav-group-static { display: flex; }
    }

    /*  the label of a bare group is a <button>, which neither matches the
        global `a` rule nor inherits its colour, so it is given the very link
        colour of its sibling nav entries. Every label also keeps the height of
        a text line, so its pull-down panel -- anchored to the bottom edge of
        the label -- starts at the very same offset for all of them; a label
        carrying just an icon is shorter than its text siblings on its own.  */
    .nav-group-toggle {
        color:      var(--brand-400);
        min-height: 1.5em;
    }

    /*  a group label adopts the foreground colour (white) exactly while it or
        one of its pull-down members is selected. Hovering adds the colour only
        for a label which is a page of its own, through the .nav-spy rule
        above; a bare label carries no .nav-spy class at all.  */
    .nav-group-toggle.is-active { color: var(--foreground); }

    /*  header background layer and collapsed mobile drop-down panel: the
        translucent brand gradient plus the frosted backdrop blur, kept off the
        <header> element itself (see the markup comment) so it does not trap
        the mobile nav panel's own blur. The panel shares the exact style so
        the open menu reads identically to the header bar it hangs from; it is
        cleared again from the `lg` breakpoint upwards, where the nav is an
        inline, transparent part of the header.  */
    .nav-bar-bg,
    .nav-menu-panel {
        background: linear-gradient(to right,
            color-mix(in oklch, var(--background) 80%, transparent),
            color-mix(in oklch, color-mix(in oklch, var(--background) 70%, var(--brand-600)) 80%, transparent),
            color-mix(in oklch, var(--background) 80%, transparent)
        );
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
    }
    @media (width >= 64rem) {
        .nav-menu-panel {
            background: transparent;
            -webkit-backdrop-filter: none;
            backdrop-filter: none;
        }

        /*  here a navigation group also opens on hovering or focusing it  */
        .nav-group:hover        .nav-group-menu,
        .nav-group:focus-within .nav-group-menu { display: flex; }

        /*  the flat brand tint shared by the box of an open group label and
            the box of its pull-down panel, so the two read as one body. It is
            kept flat rather than a gradient, so no entry of the panel sits on
            a brighter ground than its siblings.  */
        .nav-group {
            --nav-group-bg: color-mix(in oklch, color-mix(in oklch, var(--background) 55%, var(--brand-600)) 92%, transparent);
        }

        /*  the group pull-down panel takes over the very look the mobile nav
            panel drops here. Its drop shadow is clipped away along the top
            edge, where the label box joins it seamlessly.  */
        .nav-group-panel {
            background: var(--nav-group-bg);
            -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
            box-shadow: 0 10px 20px -5px rgb(0 0 0 / 0.45);
            clip-path: inset(0 -40px -40px -40px);
        }

        /*  while its panel is open, the group label wears the very box the
            panel wears, joined to it without a seam. It is drawn as a
            pseudo-element bled out of the label box, so the neighbouring nav
            entries keep their places, and its drop shadow is clipped away
            along the bottom edge, so it never falls onto the panel below.  */
        .nav-group:hover        .nav-group-toggle::before,
        .nav-group:focus-within .nav-group-toggle::before,
        .nav-group-toggle[aria-expanded="true"]::before {
            content: "";
            position: absolute;
            inset: -0.5rem -0.75rem 0;
            z-index: -1;
            border-radius: 0.375rem 0.375rem 0 0;
            background: var(--nav-group-bg);
            -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
            box-shadow: 0 0 20px 0 rgb(0 0 0 / 0.45);
            clip-path: inset(-40px -40px 0 -40px);
        }
    }

    /*  a group held shut after a click on one of its entries, until the
        pointer has left it again. It comes last on purpose: it has to beat
        the hover-driven opening above, which carries the very same
        specificity, and hence wins by source order alone.  */
    .nav-group[data-closed] .nav-group-menu           { display: none; }
    .nav-group[data-closed] .nav-group-toggle::before { content: none; }
</style>
