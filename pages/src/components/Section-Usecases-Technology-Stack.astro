/*  "Use Case: Technology Stack" section: the walk-through of establishing and
    evolving the technology stack of a project with ASE. Still a placeholder.  */

import Layers from "@lucide/astro/icons/layers"
---
<section id="usecase-technology-stack" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2">
            Use Case: <span class="text-accent">Technology Stack</span>
        </h2>
        <p class="ase-lead ase-justify">
            How to establish and evolve the technology stack of a project
            with <b>ASE</b>: from discovering candidate components over
            evaluating them to reconciling the resulting artifacts.
        </p>
    </header>

    <div class="mt-12" data-reveal>
        <p class="ase-eyebrow">Work in Progress</p>
        <h3 class="ase-h3 flex items-start gap-2">
            <Layers class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
            <span>Content Still To Come</span>
        </h3>
        <p class="mt-4 text-foreground-secondary ase-justify">
            This use case is still under construction. It will walk through
            the <b>ASE</b> skills involved in the technology stack of a
            project, step by step, with the concrete commands to run.
        </p>
    </div>
</section>
