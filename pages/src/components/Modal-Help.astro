/*  full-viewport help modal: a build-time-assembled, scrollable man-page
    browser for all ASE skills. The reusable Modal shell wraps a two-pane
    layout — a sticky, grouped skill-index sidebar plus a scrollable rendered
    pane. At build time we read every `plugin/skills/<skill>/help.md`, render
    it to HTML via `marked`, and inline the result. Any element on the page
    carrying `data-help-id` opens the modal and jumps to the matching skill;
    the Modal shell handles the close button and Escape.

    The shown man page is deep-linkable: the URL fragment "#help/<skill-id>"
    is the single source of truth, every man-page hop pushes a History API
    entry, and the copy-link button hands out the current deep link.  */

import fs              from "node:fs"
import path            from "node:path"
import { marked }      from "marked"
import Modal           from "./Modal-Shell.astro"
import { skillGroups } from "../data/skills.ts"

/*  locate the in-repo skills directory relative to the `pages/` project root
    (`pages/etc/astro.config.mjs` runs from there), mirroring the `node:fs` +
    `node:path` style already used by the Astro config.  */
const skillsDir = path.resolve(process.cwd(), "..", "plugin", "skills")

/*  assemble a map of skill-id -> { id, title, html } by reading and rendering
    each skill's `help.md`. The content is trusted, build-time, in-repo
    material, so it is rendered without an HTML sanitizer.  */
interface HelpDoc {
    id:    string
    title: string
    html:  string
}

const helpDocs: Record<string, HelpDoc> = {}
for (const id of fs.readdirSync(skillsDir)) {
    const file = path.join(skillsDir, id, "help.md")
    if (!fs.existsSync(file)) continue
    const md = fs.readFileSync(file, "utf8")

    /*  derive the title from the `##  NAME` line of the form
        "`<id>` - <Title>"; fall back to the bare skill id.  */
    let title = id
    const m = md.match(/^##\s+NAME\s*\n+`[^`]+`\s*-\s*(.+)$/m)
    if (m) title = m[1].trim()

    /*  rewrite the relative `SEE ALSO` cross-links ("../ase-<id>/help.md")
        into in-modal `data-help-id` triggers, so they reuse the existing
        click handler and jump within the open modal instead of pointing at
        a non-existent off-site page.  */
    const body = (marked.parse(md) as string).replace(
        /href="\.\.\/([a-z0-9_-]+)\/help\.md"/g,
        (_m, ref) => `data-help-id="${ref}"`
    )

    /*  prepend a separator heading naming the skill. It is invisible in the
        regular one-doc-at-a-time mode and only surfaces once the pane enters
        search mode, where it separates the stacked result documents.  */
    const html = `<p class="help-doc-head">${id} - ${title}</p>` + body

    helpDocs[id] = { id, title, html }
}

/*  flatten the shared catalog into the rendered-pane order (groups, then the
    skills within each group), skipping any id without a readable help.md.  */
const orderedDocs: HelpDoc[] = []
for (const group of skillGroups)
    for (const id of group.skills)
        if (helpDocs[id]) orderedDocs.push(helpDocs[id])
---
<Modal id="help-modal" label="Skill help">
    {/* copy-link button: hands out the deep link of the currently shown
        man-page. It sits next to the shell's close button and reuses the
        page-global `Clipboard-Copy` handler, which reads `data-copy` at click
        time and briefly flips the label to "Copied"; the value itself starts
        out empty and is kept current by the script below. */}
    <button
        type="button"
        id="help-copy"
        data-copy=""
        class="fixed right-20 top-5 z-[101] grid h-12 cursor-pointer place-items-center rounded-full bg-accent/55 px-5 text-sm font-bold leading-none text-white shadow-lg backdrop-blur transition-colors hover:bg-accent/80"
    >Copy link</button>

    <div class="grid h-[85vh] w-[94vw] max-w-6xl grid-cols-1 overflow-hidden rounded-lg border border-border-strong bg-background shadow-2xl sm:grid-cols-[16rem_1fr]">
        {/* sticky grouped skill-index sidebar, headed by the full-text search
            box. As the whole sidebar is desktop-only ("hidden sm:block"), so is
            the search box it carries. */}
        <nav class="hidden overflow-y-auto border-r border-border-strong bg-background-secondary p-4 sm:block sm:max-h-[85vh]" aria-label="Skill index">
            <div class="mb-4">
                <input
                    type="search"
                    id="help-search"
                    autocomplete="off"
                    placeholder="Search man-pages…"
                    aria-label="Search man-pages"
                    class="w-full rounded-md border border-border-strong bg-background px-2 py-1 text-sm text-foreground placeholder:text-foreground-muted focus:border-accent focus:outline-none"
                />
                <p id="help-search-hint" class="mt-2 hidden text-xs italic text-foreground-muted">no matches</p>
            </div>
            {skillGroups.map((group) => (
                <div class="mb-4" data-help-group>
                    <p class="text-xs font-bold uppercase tracking-wider text-accent">{group.label}</p>
                    <ul class="mt-2 space-y-0.5 text-sm leading-tight text-foreground-secondary">
                        {group.skills.filter((id) => helpDocs[id]).map((id) => (
                            <li>
                                <button
                                    type="button"
                                    data-help-id={id}
                                    class="block w-full cursor-grab text-left text-foreground-secondary transition-colors hover:text-white"
                                >{id}</button>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </nav>

        {/* scrollable man-page pane: every doc is assembled at build time but
            only the currently selected one is shown (the rest carry `hidden`);
            the open/click script toggles which `#help-<id>` article is visible. */}
        <div id="help-modal-pane" class="max-h-[85vh] overflow-y-auto p-6 sm:p-8">
            {orderedDocs.map((doc) => (
                <article id={`help-${doc.id}`} class="help-md hidden" data-help-title={doc.title} set:html={doc.html} />
            ))}
            <p id="help-search-none" class="hidden text-center text-foreground-muted"></p>
        </div>
    </div>
</Modal>

{/* open on a trigger click and show only the chosen skill; the Modal shell
    handles closing. Sidebar and `SEE ALSO` links switch the shown doc within
    the already-open modal. The search box on top of the sidebar switches the
    pane into a "searching" mode, in which the sidebar is reduced to the
    matching skills and the pane stacks all their man-pages at once, with every
    keyword hit wrapped in a <mark>. Which man-page is shown is routed through
    the URL fragment "#help/<skill-id>", so it survives sharing, bookmarking,
    and the back button. This script is bundled (not `is:inline`), so it can
    import the fuzzy-matching helpers from NPM. */}
<script>
    import { diceCoefficient } from "dice-coefficient"
    import levenshtein         from "fast-levenshtein"

    const helpModal = document.getElementById("help-modal")
    const helpPane  = document.getElementById("help-modal-pane")
    const helpInput = document.getElementById("help-search") as HTMLInputElement | null
    const helpHint  = document.getElementById("help-search-hint")
    const helpNone  = document.getElementById("help-search-none")
    const helpCopy  = document.getElementById("help-copy")
    if (helpModal && helpPane && helpInput && helpHint && helpNone && helpCopy) {
        /*  shortest keyword still eligible for fuzzy matching: below it the
            "levenshtein <= 2" branch degenerates and would pull in nearly
            every short word of the corpus.  */
        const FUZZY_MIN = 4

        /*  per-article caches, all filled lazily on first use: the lower-cased
            plain text and the distinct words used for matching, plus the
            pristine markup used to undo the injected <mark> wrappers.
            `highlighted` tracks which articles currently carry such wrappers
            and hence need that undo.  */
        const docText     = new Map<string, string>()
        const docWords    = new Map<string, Set<string>>()
        const docHTML     = new Map<string, string>()
        const highlighted = new Set<string>()

        /*  the corpus vocabulary and, per keyword, its fuzzy-equivalent words
            within that vocabulary -- the latter cached across keystrokes, as
            the fuzzy comparison is by far the expensive part.  */
        const vocab = new Set<string>()
        const fuzzy = new Map<string, string[]>()

        /*  the currently shown doc, the doc to fall back to once the running
            search is cleared again, and the pending keystroke debounce.  */
        let shown    = ""
        let restore  = ""
        let debounce = 0

        const articles = (): HTMLElement[] =>
            Array.from(helpPane.querySelectorAll<HTMLElement>(".help-md"))

        /*  highlight the matching sidebar entry as active (white + bold).  */
        const markActive = (id: string) => {
            helpModal.querySelectorAll("nav [data-help-id]").forEach((b) => {
                const active = b.getAttribute("data-help-id") === id
                b.classList.toggle("text-white", active)
                b.classList.toggle("font-bold", active)
            })
        }

        /*  restore the pristine markup of every article that was highlighted,
            so the next query always starts over from undamaged HTML.  */
        const unhighlight = () => {
            highlighted.forEach((id) => {
                const article = document.getElementById("help-" + id)
                if (article) article.innerHTML = docHTML.get(id)!
            })
            highlighted.clear()
        }

        /*  wrap every keyword hit in the article's text nodes into a <mark>.
            Walking the text nodes (instead of replacing in the raw HTML) keeps
            tags and attributes untouched.  */
        const highlight = (article: HTMLElement, id: string, re: RegExp) => {
            if (!docHTML.has(id)) docHTML.set(id, article.innerHTML)
            const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT)
            const nodes: Text[] = []
            let node: Node | null
            while ((node = walker.nextNode()) !== null)
                nodes.push(node as Text)
            let hit = false
            nodes.forEach((text) => {
                const value = text.nodeValue ?? ""
                const frag  = document.createDocumentFragment()
                let last = 0
                let m: RegExpExecArray | null
                re.lastIndex = 0
                while ((m = re.exec(value)) !== null) {
                    if (m.index > last)
                        frag.appendChild(document.createTextNode(value.slice(last, m.index)))
                    const mark = document.createElement("mark")
                    mark.className   = "help-hit"
                    mark.textContent = m[0]
                    frag.appendChild(mark)
                    last = m.index + m[0].length
                }
                if (last === 0) return
                if (last < value.length)
                    frag.appendChild(document.createTextNode(value.slice(last)))
                text.parentNode?.replaceChild(frag, text)
                hit = true
            })
            if (hit) highlighted.add(id)
        }

        /*  leave search mode: drop the highlights, un-reduce the sidebar, and
            hide both no-match notices. Which doc is shown is left to the caller.  */
        const leave = () => {
            unhighlight()
            helpPane.classList.remove("searching")
            helpModal.querySelectorAll("nav [data-help-id]").forEach((b) => {
                b.parentElement?.classList.remove("hidden")
            })
            helpModal.querySelectorAll("[data-help-group]").forEach((g) => {
                g.classList.remove("hidden")
            })
            helpHint.classList.add("hidden")
            helpNone.classList.add("hidden")
        }

        /*  reflect the shown man-page in the document title and in the
            copy-link button, so a bookmark gets a meaningful default name and
            the deep link can be handed out with a single click.  */
        const reflect = (id: string, article: HTMLElement) => {
            document.title = id + " - " + (article.getAttribute("data-help-title") ?? "")
            helpCopy.setAttribute("data-copy", location.origin + location.pathname + "#help/" + id)
        }

        const select = (id: string) => {
            const target = document.getElementById("help-" + id)
            if (!target) return
            reflect(id, target)
            /*  within an active search a still-matching target is merely
                scrolled to inside the stacked result list, while a target
                filtered out of the results (e.g. a `SEE ALSO` cross-link)
                leaves search mode first.  */
            if (helpPane.classList.contains("searching")) {
                if (!target.classList.contains("hidden")) {
                    markActive(id)
                    target.scrollIntoView({ block: "start" })
                    return
                }
                helpInput.value = ""
                leave()
            }
            /*  show only the selected article, hide all the others.  */
            shown = id
            articles().forEach((a) => {
                a.classList.toggle("hidden", a !== target)
            })
            markActive(id)
            /*  reset the pane to the top of the freshly shown man-page.  */
            helpPane.scrollTop = 0
        }

        /*  the URL fragment "#help/<skill-id>" is the single source of truth
            for the shown man-page, which makes it shareable, bookmarkable, and
            leavable via the browser's back button. Its "/" separator keeps such
            a route distinct from the plain section anchors ("#usage", "#setup",
            ...), so it never scroll-jumps the page behind the modal.  */
        const ROUTE = /^#help\/([a-z0-9_-]+)$/

        const routeOf = (hash: string): string => {
            const m = hash.match(ROUTE)
            return m !== null ? m[1] : ""
        }

        const isOpen = (): boolean =>
            getComputedStyle(helpModal).display !== "none"

        /*  drive the modal from a URL fragment: a resolvable route shows its
            man-page, anything else closes the modal through the shell's own
            close button (so its scroll-unlock and "modal:close" event still
            fire). Idempotent, as a history traversal can deliver the very same
            change through both listeners registered below.  */
        const apply = (hash: string) => {
            const id = routeOf(hash)
            if (id !== "" && document.getElementById("help-" + id) !== null) {
                /*  a fresh open always starts from a clean, unfiltered state.  */
                if (!isOpen()) {
                    helpModal.style.display = "grid"
                    helpInput.value = ""
                    leave()
                }
                select(id)
            }
            else if (isOpen())
                helpModal.querySelector<HTMLElement>("[data-modal-close]")?.click()
        }

        /*  navigate to a man-page: one History API entry per hop, so the back
            button walks the visited man-pages and finally leaves the modal.  */
        const go = (id: string) => {
            if (id === "") return
            if (routeOf(location.hash) !== id)
                history.pushState(null, "", "#help/" + id)
            apply(location.hash)
        }

        const escapeRE = (s: string): string =>
            s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")

        /*  fill the text/word caches of an article and feed the corpus
            vocabulary. Words are the same `[^a-zA-Z0-9]+`-delimited segments
            `@rse/stx` matches its task names by, so "ase-code-craft" also
            contributes "ase", "code", and "craft".  */
        const index = (article: HTMLElement, id: string) => {
            if (docText.has(id)) return
            const text  = (article.textContent ?? "").toLowerCase()
            const words = new Set(text.split(/[^a-z0-9]+/).filter(Boolean))
            words.forEach((w) => { vocab.add(w) })
            docText.set(id, text)
            docWords.set(id, words)
        }

        /*  the fuzzy-equivalent vocabulary words of a keyword, using the very
            "fuzzy match" strategy of `@rse/stx`. Keywords shorter than
            FUZZY_MIN are taken literally, as the edit distance alone would
            otherwise equate them with almost anything.  */
        const fuzzyWords = (keyword: string): string[] => {
            if (fuzzy.has(keyword)) return fuzzy.get(keyword)!
            const words: string[] = []
            if (keyword.length >= FUZZY_MIN)
                vocab.forEach((given) => {
                    if (
                        Math.abs(keyword.length - given.length) <= 1
                        && (
                            diceCoefficient(keyword, given) >= 0.50
                            || levenshtein.get(keyword, given) <= 2
                        )
                    )
                        words.push(given)
                })
            fuzzy.set(keyword, words)
            return words
        }

        /*  the alternation matching everything worth highlighting in a doc:
            the keywords themselves as plain substrings, plus that doc's own
            fuzzy variants as whole words. Longest alternative first, so a
            variant is never cut short by the keyword nested inside it.  */
        const buildRE = (keywords: string[], variants: string[]): RegExp => {
            const alts = keywords.map((k) => ({ len: k.length, src: escapeRE(k) }))
                .concat(variants.map((w) => ({
                    len: w.length,
                    src: "(?<![a-z0-9])" + escapeRE(w) + "(?![a-z0-9])"
                })))
            alts.sort((a, b) => b.len - a.len)
            return new RegExp(alts.map((a) => a.src).join("|"), "gi")
        }

        /*  collect the docs in which *every* keyword occurs (AND logic), along
            with the fuzzy variants that carried them, as those have to be
            highlighted too.  */
        const collect = (keywords: string[], useFuzzy: boolean) => {
            const hits: { article: HTMLElement, id: string, variants: string[] }[] = []
            articles().forEach((article) => {
                const id    = article.id.slice(5)
                const text  = docText.get(id)!
                const words = docWords.get(id)!
                const variants: string[] = []
                const hit = keywords.every((k) => {
                    if (text.indexOf(k) >= 0) return true
                    if (!useFuzzy) return false
                    const near = fuzzyWords(k).filter((w) => words.has(w))
                    variants.push(...near)
                    return near.length > 0
                })
                if (hit) hits.push({ article, id, variants })
            })
            return hits
        }

        /*  apply the current query in up to two passes: literal substrings
            first and, only if those match nothing at all, the fuzzy variants.
            The edit-distance neighborhood of a short word is wide enough to
            reach half the corpus, so it must stay a *fallback* for misspelled
            queries instead of diluting a correctly spelled one.  */
        const search = () => {
            const query    = helpInput.value.trim()
            const keywords = query.toLowerCase().split(/\s+/).filter(Boolean)
            unhighlight()
            if (keywords.length === 0) {
                leave()
                select(restore || shown)
                return
            }
            if (!helpPane.classList.contains("searching")) restore = shown
            helpPane.classList.add("searching")
            /*  the vocabulary must be complete before the first keyword is
                fuzzy-resolved against it, so index all articles up front.  */
            articles().forEach((article) => { index(article, article.id.slice(5)) })
            let hits = collect(keywords, false)
            const fuzzed = hits.length === 0
            if (fuzzed) hits = collect(keywords, true)
            const matched = hits.map((h) => h.id)
            articles().forEach((article) => {
                article.classList.toggle("hidden", matched.indexOf(article.id.slice(5)) < 0)
            })
            hits.forEach((h) => { highlight(h.article, h.id, buildRE(keywords, h.variants)) })
            /*  reduce the sidebar to the matching skills, dropping the group
                headings that ran empty in the process.  */
            helpModal.querySelectorAll("nav [data-help-id]").forEach((b) => {
                b.parentElement?.classList.toggle("hidden", matched.indexOf(b.getAttribute("data-help-id") ?? "") < 0)
            })
            helpModal.querySelectorAll("[data-help-group]").forEach((g) => {
                g.classList.toggle("hidden", g.querySelectorAll("li:not(.hidden)").length === 0)
            })
            helpNone.textContent = "No man-page matches all keywords of “" + query + "”."
            helpHint.textContent = matched.length > 0 ? "fuzzy matches" : "no matches"
            helpHint.classList.toggle("hidden", matched.length > 0 && !fuzzed)
            helpNone.classList.toggle("hidden", matched.length > 0)
            helpPane.scrollTop = 0
        }

        helpInput.addEventListener("input", () => {
            window.clearTimeout(debounce)
            debounce = window.setTimeout(search, 120)
        })

        /*  route every `data-help-id` trigger through a single delegated
            click handler instead of per-element listeners: the rewritten
            `SEE ALSO` cross-links live inside the article markup, which
            `unhighlight` restores wholesale from the cached HTML, so directly
            bound listeners would be detached by the first search.  */
        document.addEventListener("click", (event) => {
            const node    = event.target instanceof Element ? event.target : null
            const trigger = node?.closest("[data-help-id]")
            if (!trigger) return
            go(trigger.getAttribute("data-help-id") ?? "")
        })

        /*  external search triggers (the box below the on-page skill catalog):
            Enter opens the modal, adopts the typed query, and runs the search
            right away. The pane is first parked on the initial man-page, so
            clearing the query inside the modal falls back onto a real doc
            instead of an empty pane.  */
        document.querySelectorAll<HTMLInputElement>("input[data-help-search]").forEach((input) => {
            input.addEventListener("keydown", (event) => {
                if (event.key !== "Enter") return
                event.preventDefault()
                go(articles()[0]?.id.slice(5) ?? "")
                const query = input.value.trim()
                if (query === "") return
                helpInput.value = query
                search()
            })
        })

        /*  keep the modal in sync with the URL: a history traversal (back and
            forward) and a manually edited fragment both re-apply the route,
            while closing the modal restores the page title and strips the
            fragment again -- via "replaceState", so a mere dismissal adds no
            history entry (the same idiom the back-to-top button already uses
            in `Progress.astro`). The final apply picks up a deep link (or a
            reload) once the DOM is in place.  */
        const pageTitle = document.title
        window.addEventListener("popstate",   () => { apply(location.hash) })
        window.addEventListener("hashchange", () => { apply(location.hash) })
        helpModal.addEventListener("modal:close", () => {
            document.title = pageTitle
            if (routeOf(location.hash) !== "")
                history.replaceState(null, "", location.pathname + location.search)
        })
        apply(location.hash)
    }
</script>

<style is:global>
    /*  styled man-page typography for the rendered help.md, aligned with the
        theme tokens in `theme.css`/Tailwind so the Markdown reads as a clean,
        framed man-page rather than raw text.  */
    .help-md {
        color: var(--foreground-secondary);
        font-size: 0.95rem;
        line-height: 1.5;
    }
    .help-md h1,
    .help-md h2,
    .help-md h3 {
        color: var(--foreground);
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }
    .help-md h1 { font-size: 1.5rem;  margin: 0 0 0.75rem; }
    .help-md h2 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; color: var(--accent); }
    .help-md h3 { font-size: 1.0rem;  margin: 1.0rem 0 0.4rem; }
    .help-md p { margin: 0.5rem 0; }
    .help-md a { color: var(--accent); }
    .help-md a:hover { color: var(--accent-hover); }
    /*  the rewritten `SEE ALSO` cross-links carry `data-help-id` instead of an
        `href`, so give them the same grab cursor and white hover as the other
        in-modal skill triggers.  */
    .help-md a[data-help-id] {
        cursor: grab;
        transition: color 0.15s;
    }
    .help-md a[data-help-id]:hover,
    .help-md a[data-help-id]:hover code { color: #fff; }
    .help-md ul {
        margin: 0.5rem 0;
        padding-left: 1.25rem;
        list-style: disc;
    }
    .help-md li { margin: 0.2rem 0; }
    .help-md code {
        border: 1px solid var(--border);
        border-radius: 0.3rem;
        background: var(--background-elevated);
        color: var(--foreground);
        font-family: var(--font-mono);
        font-size: 0.85em;
        padding: 0.05em 0.35em;
    }
    .help-md pre {
        margin: 0.75rem 0;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: var(--background-elevated);
        overflow-x: auto;
    }
    .help-md pre code {
        border: 0;
        padding: 0;
        background: transparent;
    }
    /*  the per-document separator heading, prepended at build time: invisible
        in the regular one-doc-at-a-time mode and only surfacing in search mode,
        where the pane stacks all matching man-pages.  */
    .help-md .help-doc-head {
        display: none;
    }
    #help-modal-pane.searching .help-md .help-doc-head {
        display: block;
        margin: 2rem 0 1rem;
        padding: 0.4rem 0.75rem;
        border-radius: 0.3rem;
        background: var(--brand-800);
        color: var(--brand-200);
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        text-align: center;
    }
    /*  the keyword hits wrapped by the search: blue background, white text.  */
    .help-md mark.help-hit {
        border-radius: 0.2rem;
        background: var(--brand-600);
        color: #fff;
        padding: 0 0.1em;
    }
</style>
