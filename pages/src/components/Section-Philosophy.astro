/*  "Philosophy" section: two text/diagram pairs laid out as alternating
    two-column rows (zig-zag), mirroring the highlights rows. Each text block
    has a brand glow behind it; each diagram opens the shared image modal on
    click.  */

import GlowSide   from "./Widget-Glow-Side.astro"
import Diagram    from "./Widget-Diagram.astro"
import Annotation from "./Widget-Annotation.astro"
import Signal     from "@lucide/astro/icons/signal"
import Footprints from "@lucide/astro/icons/footprints"
---
<section id="philosophy" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/4">
                Delegate your work,<br/>
                not your<br/>
                accountability!
            </Annotation>
            Understand Our <span class="text-accent">Philosophy</span>
        </h2>
        <p class="ase-lead ase-justify">
            <b>ASE</b> is based on{" "}
            <b>Dr. Ralf S. Engelschall</b>'s Agentic AI Level model,
            which explains the distinct <i>modi operandi</i> of working
            with AI agents. <b>ASE</b> allows
            engineers to stay in the driver's seat and to decide the
            <i>modus operandi</i> per task themselves.
            In practice, usually based on the risk one can accept on the
            currently involved piece of software.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="relative isolate lg:order-1" data-reveal="right">
                <p class="ase-eyebrow">Agentic AI Levels</p>
                {/*  "mt-1" centers the icon on the first line box of the
                     heading, so the two-line title keeps it on top  */}
                <h3 class="ase-h3 flex items-start gap-2">
                    <Signal class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>From Manual To<br/>Fully Autonomous</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    <b>ASE</b> supports <b>Dr. Ralf S. Engelschall</b>'s{" "}
                    <b>Agentic AI Level Model</b>, which classifies
                    the gradual sharing of work with AI agents.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    <b>Level 0 (manual)</b>: you do everything
                    manually and without support from the AI agent at all
                    &mdash; think "do-it-yourself", where you obviously
                    know the results and inherently train your own
                    skills.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    <b>Level 1 (assisted)</b>: you are supported by the
                    AI agent for individual steps only &mdash; think
                    "assistant", where you still know all results in
                    detail, but inherently your practical execution
                    skills can partly start to wane in the long term.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    <b>Level 2 (supervised)</b>: you are working on
                    an entire task with the AI agent as an equal pair
                    &mdash; think "co-worker", where your colleague
                    shares the task workload with you, you mutually
                    review each other's results, hence you still know
                    all results in detail, but inherently your practical
                    execution skills can be lost in the long term.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    <b>Level 3 (delegated)</b>: you are delegating
                    entire workflows to the AI agent &mdash; think
                    "offshoring", where your colleague shoulders the entire
                    workload for you, you just review the results, but
                    your own practical execution skill and your ability
                    to quality-assure the results will be forever lost
                    if you are not regularly, at least virtually,
                    replaying the delegated work.
                </p>
                <p class="text-foreground-secondary ase-indent-p ase-justify">
                    <b>Level 4 (autonomous)</b>: you are assigning
                    entire process lifecycles to the AI agent &mdash;
                    think "third-party", where your vendor does
                    everything for you fully autonomously, you just take
                    the results as is, and your own practical execution
                    skill doesn't matter as it is already out of scope.
                </p>
            </div>
            <div class="lg:order-2 relative" data-reveal="left">
                <Annotation flat class="hidden sm:block right-0 -translate-x-1/2">
                    ASE allows you<br/>
                    to choose the<br/>
                    modus operandi!
                </Annotation>
                <Diagram src="/assets/agentic-levels.svg" label="agentic levels diagram" />
            </div>
        </div>
    </div>

    <div class="mt-12 flex flex-col gap-12">
        <div class="ase-grid-split">
            <div class="relative isolate lg:order-2" data-reveal="left">
                <GlowSide variant="text" side="right" />
                <p class="ase-eyebrow">Skills &amp; Workflows</p>
                <h3 class="ase-h3 flex items-start gap-2">
                    <Footprints class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                    <span>Step-Wise Driving,<br/>You In The Loop</span>
                </h3>
                <p class="mt-4 text-foreground-secondary ase-justify">
                    Within the above Agentic AI Levels, <b>ASE</b> provides its
                    various skills to let the engineer trigger the
                    next steps. Some skills are stand-alone, others
                    are part of a particular operation mode that
                    chains skills into a repeatable workflow.
                </p>
            </div>
            <div class="lg:order-1" data-reveal="right">
                <Diagram src="/assets/workflow.svg" label="ASE usage workflow diagram" />
            </div>
        </div>
    </div>
</section>
