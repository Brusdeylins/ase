/*  decorative blue radial wash at the top of its (relative, isolate) parent:
    a brand-colored ellipse hanging in from the top edge, laid over a vertical
    background gradient which fades into the page background at the band's
    bottom. The band is one viewport tall, so it stays the very same wash on a
    short page and on a long one.  */
---
<div
    class="pointer-events-none absolute inset-x-0 top-0 h-screen -z-10"
    style="background:
        radial-gradient(ellipse 60% 180% at 50% -20%, color-mix(in oklch, var(--brand-500) 30%, transparent), transparent 75%),
        linear-gradient(to bottom, var(--background-secondary), var(--background));"
    aria-hidden="true"
></div>
