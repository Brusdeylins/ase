/*  full-viewport video modal: the reusable Modal shell wrapped around a
    Video.js player. Any element on the page carrying `data-video-src` (and
    optionally `data-video-label`) opens it on click; the Modal shell handles
    the close button and Escape, and the player is paused when the overlay
    closes.  */

import Modal from "./Modal-Shell.astro"
---
<Modal id="video-modal" label="Video player">
    <div class="w-full max-w-4xl">
        <video-player>
            <video-neutral-skin>
                <video id="video-modal-player" playsinline></video>
            </video-neutral-skin>
        </video-player>
    </div>
</Modal>

{/* driven by Video.js: open on a thumbnail click, close via the Modal shell
    (close button or Escape). Each trigger carries the clip via
    `data-video-src` / `data-video-label`. Bundled by Vite (no `is:inline`)
    so the Video.js imports resolve. The player UI follows the native media
    element, so it is driven through the plain `HTMLVideoElement` API. */}
<script>
    import "@videojs/html/video/player"
    import "@videojs/html/video/neutral-skin"

    const videoModal = document.getElementById("video-modal")
    const videoSkin  = document.querySelector<HTMLElement>("#video-modal video-neutral-skin")
    const videoEl    = document.getElementById("video-modal-player") as HTMLVideoElement | null
    if (videoModal && videoSkin && videoEl) {
        /*  the clips are silent, so hide the mute button and volume popover,
            and confine the darkening backdrop, which the skin fades in over
            the entire clip while the controls are visible, to a short strip
            behind the control bar. Packaged skins provide no settings for
            this, hence this hooks into the (open) shadow root of the skin and
            relies on its internal names, which may change between releases.  */
        if (videoSkin.shadowRoot) {
            const sheet = new CSSStyleSheet()
            sheet.replaceSync(`
                media-mute-button, media-volume-popover {
                    display: none !important;
                }
                .video-controls-backdrop {
                    top: auto !important;
                    height: calc(var(--media-spacing) * 20) !important;
                    background-image: linear-gradient(to top,
                        color-mix(in oklab, var(--media-backdrop) 50%, transparent),
                        transparent) !important;
                }
            `)
            videoSkin.shadowRoot.adoptedStyleSheets = [ ...videoSkin.shadowRoot.adoptedStyleSheets, sheet ]
        }

        /*  size the player to the intrinsic aspect ratio of each clip  */
        videoEl.addEventListener("loadedmetadata", () => {
            if (videoEl.videoWidth > 0 && videoEl.videoHeight > 0)
                videoSkin.style.setProperty("--video-ratio", `${videoEl.videoWidth} / ${videoEl.videoHeight}`)
        })

        const openVideo = (src: string, label: string) => {
            videoEl.src = src
            videoEl.setAttribute("aria-label", label)
            videoModal.style.display = "grid"
            /*  intentionally ignore autoplay-policy rejections of play()  */
            videoEl.play().catch(() => {})
        }
        document.querySelectorAll("[data-video-src]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                openVideo(trigger.getAttribute("data-video-src") || "", trigger.getAttribute("data-video-label") || "")
            })
        })
        /*  the Modal shell handles close-button + Escape; pause the
            player whenever the overlay reports it has closed.  */
        videoModal.addEventListener("modal:close", () => { videoEl.pause() })
    }
</script>

<style is:global>
    /*  theme Video.js to the steel-blue brand and keep the modal player within
        the viewport: the skin takes the intrinsic aspect ratio of the clip
        (`--video-ratio`, set on `loadedmetadata`) and its width is capped
        by both the wrapper and the height of 90% of the viewport.  */
    #video-modal video-player {
        --media-accent-color:  var(--accent);
        --media-border-radius: 0.75rem;
        --media-object-fit:    contain;
        display: block;
        width: 100%;
    }
    #video-modal video-neutral-skin {
        --video-ratio: 16 / 9;
        display: block;
        aspect-ratio: var(--video-ratio);
        width: min(100%, calc(90vh * var(--video-ratio)));
        margin-inline: auto;
        box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.6);
    }
</style>
