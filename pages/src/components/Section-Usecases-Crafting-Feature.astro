/*  "Use Case: Crafting Feature" section: the walk-through of crafting a new
    feature with ASE, from task plan to review. Still a placeholder.  */

import Hammer from "@lucide/astro/icons/hammer"
---
<section id="usecase-crafting-feature" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2">
            Use Case: <span class="text-accent">Crafting Feature</span>
        </h2>
        <p class="ase-lead ase-justify">
            How to craft a new feature with <b>ASE</b>: from the initial task
            plan over the implementation to the review of the resulting
            change set.
        </p>
    </header>

    <div class="mt-12" data-reveal>
        <p class="ase-eyebrow">Work in Progress</p>
        <h3 class="ase-h3 flex items-start gap-2">
            <Hammer class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
            <span>Content Still To Come</span>
        </h3>
        <p class="mt-4 text-foreground-secondary ase-justify">
            This use case is still under construction. It will walk through
            the <b>ASE</b> skills involved in crafting a feature, step by
            step, with the concrete commands to run.
        </p>
    </div>
</section>
