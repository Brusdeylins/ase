/*  external-link targeting: make every off-site link ("http"/"https" target)
    open in a new browser tab, so following a reference never tears the visitor
    out of the single-page site.  */
---
<script is:inline>
    (function () {
        document.querySelectorAll("a[href^=\"http\"]").forEach(function (link) {
            /*  respect an explicitly authored target (the opt-out).  */
            if (link.hasAttribute("target"))
                return
            /*  skip the <lite-youtube> poster anchor: its href is an SEO/no-JS
                fallback that the embed script strips once it upgrades the
                element into an in-place play button.  */
            if (link.closest("lite-youtube"))
                return
            link.setAttribute("target", "_blank")
            const rel = (link.getAttribute("rel") || "").split(/\s+/).filter(Boolean)
            for (const token of [ "noopener", "noreferrer" ])
                if (!rel.includes(token))
                    rel.push(token)
            link.setAttribute("rel", rel.join(" "))
        })
    })()
</script>
