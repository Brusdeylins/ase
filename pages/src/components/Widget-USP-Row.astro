/*  "USP Row" widget: one sub-section of a core USP of ASE, as a two-column
    row of the text (with the terminal box of the showcased commands) and the
    screenshot grid of the USP, whose columns swap on the odd rows (zig-zag,
    like the Video-Row of the sneak previews). On narrow screens the columns
    stack and the text always leads.  */

import Terminal     from "./Widget-Terminal.astro"
import Screenshot   from "./Widget-Screenshot.astro"
import type { USP } from "../data/usps.ts"

interface Props {
    usp:   USP
    index: number
}
const { usp, index } = Astro.props

/*  reveal each column from its own outer screen edge, with the
    inverted `data-reveal` naming of Scroll-Reveal ("left" starts
    off-screen to the right), swapped on the reversed rows  */
const reversed = index % 2 === 1
const Icon     = usp.icon
---
<div id={usp.id} class="ase-grid-split">
    <div class:list={[ "relative isolate", reversed ? "lg:order-2" : "lg:order-1" ]} data-reveal={reversed ? "left" : "right"}>
        <p class="ase-eyebrow">{usp.eyebrow}</p>
        {/*  "mt-1" centers the icon on the first line box of the headline,
             so a headline wrapping to several lines keeps it on top  */}
        <h3 class="ase-h3 flex items-start gap-2">
            <Icon class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
            <span>{usp.title}</span>
        </h3>
        {/*  the first paragraph keeps its distance to the headline,
             all further ones follow first-line-indented  */}
        {usp.body.map((para, i) => (
            <p class:list={[ "text-foreground-secondary ase-justify", i === 0 ? "mt-4" : "ase-indent-p" ]} set:html={para}></p>
        ))}
        <Terminal class="mt-5" prefix={usp.prefix} commands={usp.commands} helpPage={Astro.url.pathname}/>
    </div>
    <div
        class:list={[ "grid gap-2", usp.cols === 2 && "grid-cols-2", reversed ? "lg:order-1" : "lg:order-2" ]}
        data-reveal={reversed ? "right" : "left"}
    >
        {usp.shots.map((shot) => <Screenshot src={shot.src} label={shot.label} class={shot.wide ? "col-span-full" : ""}/>)}
    </div>
</div>

