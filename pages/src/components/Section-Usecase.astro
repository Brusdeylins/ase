/*  "Use Case" section: the header and abstract of one use case, followed by
    its process as a vertical timeline of numbered steps. Each step pairs a
    short narrative with the ASE skills firing at that very moment. The
    content itself comes from `data/usecases.ts`.  */

import GlowSide      from "./Widget-Glow-Side.astro"
import Annotation    from "./Widget-Annotation.astro"
import Terminal      from "./Widget-Terminal.astro"
import type { UseCase } from "../data/usecases.ts"

interface Props {
    useCase: UseCase  /*  the use case to render  */
}

const { useCase } = Astro.props

/*  render lightweight inline markup in the abstract and the step bodies: turn
    "**...**" into <b>...</b>, "*...*" into <i>...</i>, and "`...`" into
    <code>...</code>. The "**" pass runs first so the single-asterisk pass
    never consumes a bold marker.  */
const inline = (text: string) => text
    .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
    .replace(/\*(.+?)\*/g,     "<i>$1</i>")
    .replace(/`(.+?)`/g,       "<code>$1</code>")
---
<section id={useCase.id} class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2">
            <Annotation flat class="hidden sm:block right-0 -translate-x-2/3">
                One example,<br/>
                walked end to end!
            </Annotation>
            Use Case: <span class="text-accent">{useCase.label}</span>
        </h2>
        <p class="ase-lead ase-justify" set:html={inline(useCase.abstract)}/>
    </header>

    <ol class="relative mt-12 flex list-none flex-col gap-10 p-0">
        {/*  the continuous rail behind the numbered dots: shown from the "lg"
             breakpoint upwards only, where the rail column actually exists.
             Its "1.25rem" offset is half of the 2.5rem dot diameter, so the
             line runs exactly through the centers of the dots.  */}
        <span
            class="pointer-events-none absolute inset-y-0 left-[1.25rem] hidden w-px -translate-x-1/2 bg-brand-800 lg:block"
            aria-hidden="true"
        ></span>

        {useCase.steps.map((step, index) => {
            /*  bind to a capitalized name so the expression below is
                recognized as a component and not as an HTML element  */
            const Icon = step.icon
            return (
                <li class="relative">
                    {/*  only every second step carries a glow, and those
                         alternate their side, so the washes stay sparse  */}
                    {index % 2 === 0
                        && <GlowSide variant="section" side={(index / 2) % 2 === 0 ? "right" : "left"}/>}
                    {/*  the narrative column is given a bit more room than in
                         the session timeline, at the expense of the terminal
                         column, whose commands wrap anyway  */}
                    <div class="grid grid-cols-1 items-start gap-y-2 lg:grid-cols-[2.0rem_0.9fr_0.85fr] lg:gap-x-10" data-reveal>
                        <div class="self-start">
                            <span class="relative z-10 flex h-[2.5rem] w-[2.5rem] items-center justify-center rounded-full border border-border-strong bg-brand-800 font-bold text-white">
                                {index + 1}
                            </span>
                        </div>
                        <div class="self-start">
                            <p class="ase-eyebrow">{step.eyebrow}</p>
                            {/*  "mt-1" centers the icon on the first line box of the
                                 heading, so a title wrapping to several lines -- as
                                 most do in this narrow column -- keeps it on top  */}
                            <h3 class="ase-h3 flex items-start gap-2">
                                <Icon class="mt-1 h-6 w-6 shrink-0 sm:h-7 sm:w-7" stroke-width={0.75}/>
                                {step.title}
                            </h3>
                            <p class="mt-3 text-foreground-secondary ase-justify" set:html={inline(step.body)}/>
                        </div>
                        <Terminal class="mt-4 lg:mt-10" prefix="Claude Code" copy={true} commands={step.commands} helpPage={Astro.url.pathname}/>
                    </div>
                </li>
            )
        })}
    </ol>
</section>
