/*  "Unique Selling Points" section: one sub-section per core USP of ASE,
    driven by the USP data and rendered as zig-zag rows by the USP-Row.  */

import USPRow     from "./Widget-USP-Row.astro"
import Annotation from "./Widget-Annotation.astro"
import { usps }   from "../data/usps.ts"
---
<section id="usp" class="mt-4 sm:mt-12 relative isolate mx-auto max-w-4xl px-6 py-8">
    <header class="ase-section-head" data-reveal>
        <h2 class="ase-h2 relative inline-block">
            <Annotation flat class="right-0 translate-x-1/2">
                What makes<br/>
                ASE stand out<br/>
                from the crowd?
            </Annotation>
            Discover the <span class="text-accent">Unique Selling Points</span>
        </h2>
        <p class="ase-lead ase-justify">
            Five things you will not find in a bare Agentic AI Coding tool:
            being grilled before the first line changes, user-story and
            specification based Spec-Driven Development (SDD), methodology
            built into every work-step, and a communication style you can
            dial to your reading preference.
        </p>
    </header>

    <div class="mt-12 flex flex-col gap-16">
        {usps.map((usp, index) => <USPRow usp={usp} index={index}/>)}
    </div>
</section>

